# NEVER use this template key as a real credential
SAID_ADMIN_API_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SAID_DATABASE_URL=postgresql+psycopg://said:said_local_only@postgres:5432/said
SAID_ENVIRONMENT=development

# Configure all three for production institutional authentication
# SAID_ENVIRONMENT=production
# SAID_OIDC_ISSUER=https://issuer.example
# SAID_OIDC_AUDIENCE=said-api
# SAID_OIDC_JWKS_URL=https://issuer.example/.well-known/jwks.json

# CEIR quality sandbox requires an independent random HMAC key; no default.
# SAID_CEIR_HMAC_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_32_CHARS_MIN

# Mock-only data retention PREVIEW (does not delete data); 7–365 days.
SAID_MOCK_RETENTION_DAYS=90
